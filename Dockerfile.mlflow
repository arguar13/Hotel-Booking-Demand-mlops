# Kept in lockstep with the mlflow client pinned in api/ and core_ml/
# (poetry.lock). A 2.x server with a 3.x client is not a supported combination -
# the REST contract for the model registry changed between majors.
FROM ghcr.io/mlflow/mlflow:v3.15.2

# Optional local CA trust for machines where a corporate/AV proxy performs
# TLS interception on outbound HTTPS - see Dockerfile (api) for the full
# rationale. No-op everywhere the override file isn't provided.
COPY docker/local-ca-placeholder.crt docker/local-c[a].crt /tmp/local-ca/
RUN sh -c 'for f in /tmp/local-ca/*; do [ -s "$f" ] && cp "$f" /usr/local/share/ca-certificates/local-ca.crt; done; update-ca-certificates; rm -rf /tmp/local-ca'
ENV PIP_CERT=/etc/ssl/certs/ca-certificates.crt \
    REQUESTS_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt \
    SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt

# Baked in at build time rather than installed on every container start:
# faster startup and no runtime dependency on internet/PyPI access.
# psycopg2-binary: Postgres backend store. boto3: S3 (LocalStack locally,
# real S3 in prod) artifact store.
RUN pip install --no-cache-dir "psycopg2-binary>=2.9.9" "boto3>=1.34.62"

# Unprivileged user - see Dockerfile (api) for why UID 1000 specifically.
# MLFLOW_* / HOME point every path MLflow writes to at the writable home dir,
# since kubernetes/base/mlflow.yaml mounts the root filesystem read-only.
RUN useradd --create-home --uid 1000 mlflowuser
USER mlflowuser
ENV HOME=/home/mlflowuser
