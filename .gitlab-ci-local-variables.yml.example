# Copy this file to `.gitlab-ci-local-variables.yml` (gitignored, never
# committed) and fill in real values. gitlab-ci-local auto-loads that exact
# filename - no CLI flag needed.
#
# Only needed for `make ci-dry-run-train`, which runs train-smoke locally:
# that job needs read access to the DVC S3 remote to pull the toy dataset,
# and outside real GitLab CI there is no GITLAB_OIDC_TOKEN to mint AWS
# credentials from (see the .aws_auth anchor in .gitlab-ci.yml) - so boto3
# falls back to these instead.
#
# Use an IAM user/role scoped to read-only access on the DVC S3 bucket
# (hotel-mlops-artifacts-production-<account-id>/dvc-store), not root/admin
# credentials.
AWS_ACCESS_KEY_ID: changeme
AWS_SECRET_ACCESS_KEY: changeme
AWS_DEFAULT_REGION: us-east-1
