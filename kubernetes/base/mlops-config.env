# Non-secret application configuration, consumed by every Deployment through
# envFrom. Rendered by the configMapGenerator in kustomization.yaml, which
# appends a content hash to the ConfigMap's name - that is what makes a config
# change actually reach running pods: the hash changes, so the Deployment spec
# changes, so Kubernetes performs a rollout. A plain ConfigMap resource does
# not do this, and edits to it sit unnoticed until something else happens to
# restart the pod.
#
# Values marked REPLACED_BY_OVERLAY come from Terraform outputs and are set in
# kubernetes/overlays/<env>/mlops-config.env.
MLFLOW_TRACKING_URI=http://mlflow-service:5000
DB_HOST=REPLACED_BY_OVERLAY
DB_PORT=5432
POSTGRES_USER=mlops_user
POSTGRES_DB=postgres
S3_BUCKET_NAME=REPLACED_BY_OVERLAY
MODEL_REGISTRY_ALIAS=staging
# MLflow >=3 refuses any request whose Host header is not on this list
# ("possible DNS rebinding attack"), defaulting to localhost + private IPs.
# These are the in-cluster names the api and dashboard use; without them every
# client call gets a 403 and the API never loads a model. The production
# overlay appends the Load Balancer hostname so the UI is reachable too.
MLFLOW_ALLOWED_HOSTS=mlflow-service,mlflow-service:5000,mlflow-service.default.svc.cluster.local,mlflow-service.default.svc.cluster.local:5000,localhost,localhost:5000,127.0.0.1,127.0.0.1:5000
