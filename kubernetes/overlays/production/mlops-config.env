# Production values, merged over kubernetes/base/mlops-config.env.
# These come from Terraform outputs and change only when the infrastructure
# does, so they are edited by hand (unlike image tags, which CI's `deploy`
# job rewrites on every build):
#
#   terraform -chdir=terraform output rds_endpoint
#   terraform -chdir=terraform output s3_bucket_name
#
# MLFLOW_ALLOWED_HOSTS is not overridden here any more: mlflow-service is
# ClusterIP (see kubernetes/base/mlflow.yaml), reached in-cluster by service
# name or from a laptop/CI runner through `kubectl port-forward` as
# localhost:5000 - all already on the base list.
DB_HOST=REDACTED-RDS-ENDPOINT.rds.amazonaws.com
S3_BUCKET_NAME=hotel-mlops-artifacts-production-REDACTED_ACCOUNT_ID
