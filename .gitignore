# Entornos virtuales
venv/
env/
.env

# Claude Code's own local session/tool config - machine-local, not project source.
.claude/

# gitlab-ci-local: real AWS credentials for local train-smoke dry-runs.
# Only the .example template is committed - see .gitlab-ci-local-variables.yml.example
.gitlab-ci-local-variables.yml
# gitlab-ci-local's own working/output directory (service logs, volumes state)
.gitlab-ci-local/

# Machine-local root CA override for Docker builds behind a TLS-intercepting
# proxy/antivirus (see docker/local-ca-placeholder.crt and the Dockerfiles).
# Never commit an actual CA here - only the empty placeholder is tracked.
docker/local-ca.crt

# Archivos compilados y cache de Python
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
junit/

# Tooling caches (ruff, mypy, coverage) and local virtualenvs
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
.venv/
dist/
*.egg-info/

# DVC lives under core_ml/ (`dvc init --subdir`); its own generated
# core_ml/.dvc/.gitignore and core_ml/data/**/.gitignore already exclude the
# tracked datasets and local cache/config overrides.

# Terraform - .terraform.lock.hcl IS committed (deterministic provider
# versions); everything below is either regenerated by `terraform init`,
# contains live state (never belongs in git - use a remote backend), or is
# a local plan artifact.
terraform/.terraform/
terraform/bootstrap/.terraform/
# The bootstrap config keeps LOCAL state on purpose (see
# terraform/bootstrap/main.tf) and that state contains a secret access
# key - it must never be committed.
terraform/bootstrap/terraform.tfstate*
*.tfstate
*.tfstate.*
# Saved plan files, under any name (`-out=tfplan.bin` / `-out=tfdestroy.bin`
# included): a plan holds fully-resolved values, so it can contain secrets
# pulled from data sources (the RDS password) and generated credentials.
# A destroy plan is no different - it is still a rendered snapshot of state.
# Never commit one.
*.tfplan
tfplan*
tfdestroy*
crash.log
crash.*.log

# IDEs
.vscode/
.idea/
*.swp
.DS_Store
creds.json
creds.sh
creds.json
creds.sh
mlflow.db
mlruns/

# Office/Word lock files - created whenever a .docx in the repo is open
~$*
